{
    "manifest_version": 3,
    "name": "IAPI · Alta JSON",
    "description": "Alta-ს JSON პასუხების შეგროვება და ჩამოტვირთვა ხელით იმპორტისთვის.",
    "version": "0.4.0",
    "minimum_chrome_version": "120",
    "permissions": ["scripting", "storage", "declarativeNetRequestWithHostAccess"],
    "host_permissions": ["https://alta.ge/*"],
    "optional_host_permissions": ["https://iapi.ge/*", "https://imgstore.alta.ge/*"],
    "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "192": "icons/icon192.png"},
    "background": {"service_worker": "background.js", "type": "module"},
    "action": {"default_title": "Alta JSON — პანელის გახსნა", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}},
    "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
