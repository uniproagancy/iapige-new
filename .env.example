APP_NAME=IAPI.GE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ka
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# the import's own channel; debug also logs every id that came back empty
IMPORT_LOG_LEVEL=info
# requests a minute one supplier may receive; sources behind Cloudflare need this
IMPORT_RATE_PER_MINUTE=60
# drop a newly imported product that ended up with no photograph; one that has
# none cannot be shown on a card or in a listing. A supplier can override it
# with require_image in its own config — Alta's feed carries no pictures at all.
IMPORT_REQUIRE_IMAGE=false

# Zoommer from a server address: Cloudflare answers 403 whatever cookie is sent,
# so the request goes through the shop's own worker (?type=product&productId=N).
# Leave empty on a machine that is not blocked, and it goes direct.
ZOOMMER_WORKER_URL=

# Alta: the B2B price list gives the item codes, the shop front is then
# asked about each one by code.
ALTA_WSDL=http://extra.alta.com.ge/b2b/b2bEWS?WSDL
ALTA_B2B_USER=
ALTA_B2B_PASSWORD=

# The shop front's own access token, taken from a signed-in session.
ALTA_ACCESS_TOKEN=

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# https only: a session cookie sent over plain http can be read off the wire.
# Must be true in production.
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------- shop
# These reach the invoice, the emails and the structured data, so an empty
# line here is a blank on a customer's invoice or a missing SEO field.
SHOP_PHONE="032 212 10 28"
SHOP_EMAIL=info@iapi.ge
SHOP_DELIVERY_DAYS=2
SHOP_COMPANY=
SHOP_TAX_ID=
SHOP_ADDRESS=
SHOP_BANK=
SHOP_SWIFT=
SHOP_IBAN=

SHOP_ACCOUNTS="საქართველოს ბანკი|GE00BG0000000000000000|BAGAGE22"
SHOP_INVOICE_DAYS=3

# Months the "from X a month" figure is divided over. One number: the cards,
# the product page, the cart and both advertising feeds all read it, and they
# used to disagree — the shop said 12 while the feeds said 24.
INSTALMENT_MONTHS=24

# ---------------------------------------------------------------- text messages
# smsoffice.ge. The sender name has to be registered with them first — an
# unregistered one is refused at the gateway, which answers 200 and says no in
# the body, so the refusal only shows up in storage/logs/sms.log.
#
# Off everywhere but production: a staging database holds real telephone
# numbers and every one of them is chargeable. Check it with
#   php artisan sms:test 599123456
SMSOFFICE_ENABLED=false
SMSOFFICE_KEY=
SMSOFFICE_SENDER=
SMSOFFICE_TIMEOUT=10
# every message to one number instead, for testing against the real gateway
SMSOFFICE_REDIRECT_TO=

# ---------------------------------------------------------------- the call button
# What "call the customer" in the admin opens. Zoiper takes tel and callto and
# offers to register both; use sip where something else (Teams, Skype) has
# already taken tel for itself.
DIAL_SCHEME=tel
PHONE_COUNTRY=995

# schema.org sameAs — full profile URLs, or leave blank
SHOP_FACEBOOK=
SHOP_INSTAGRAM=
SHOP_YOUTUBE=
SHOP_LINKEDIN=

# ---------------------------------------------------------------- Meta pixel
# The browser and the Conversions API both need the id; only the server needs
# the token. Without the token nothing is sent from PHP and only the browser
# half survives — which is the half ad blockers remove.
FACEBOOK_PIXEL_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_API_VERSION=v24.0

# While this is set every event lands in Test Events only. Empty it when done.
FACEBOOK_TEST_EVENT_CODE=
FACEBOOK_QUEUE_EVENTS=true

# One product may take this long, in seconds: two API calls and its pictures.
# The queue's retry_after must stay longer, or a running job is handed to a
# second worker as well and the two race over the same rows.
IMPORT_TIMEOUT=300
IMPORT_IMAGE_BUDGET=120
DB_QUEUE_RETRY_AFTER=900

# Signing in with Google or Facebook. A provider with no client id is not
# offered on the sign-in form at all, so a half-finished setup shows nothing.
# The redirect must match what is registered with the provider exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

BOG_PAYMENT_PUBLIC_KEY=
BOG_PAYMENT_SECRET_KEY=
BOG_CALLBACK_URL=

BOG_INSTALLMENT_PUBLIC_KEY=
BOG_INSTALLMENT_SECRET_KEY=

TBC_CLIENT_ID=
TBC_CLIENT_SECRET=
TBC_MERCHANT_KEY=
TBC_CAMPAIGN_ID=

CREDO_MERCHANT_ID=

# Credo Split: the same widget booked against a different shop.
CREDO_SPLIT_MERCHANT_ID=

# A long random string. Set it and /cron/payments starts answering, so a
# plain cron fetch can sweep pending payments; leave it empty and that
# address does not exist. Generate one with: php artisan key:generate --show
CRON_TOKEN=
