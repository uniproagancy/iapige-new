APP_NAME=IAPI.GE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ka
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# the import's own channel; debug also logs every id that came back empty
IMPORT_LOG_LEVEL=info
# requests a minute one supplier may receive; sources behind Cloudflare need this
IMPORT_RATE_PER_MINUTE=60

# Zoommer from a server address: Cloudflare answers 403 whatever cookie is sent,
# so the request goes through the shop's own worker (?type=product&productId=N).
# Leave empty on a machine that is not blocked, and it goes direct.
ZOOMMER_WORKER_URL=

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------- shop
# These reach the invoice, the emails and the structured data, so an empty
# line here is a blank on a customer's invoice or a missing SEO field.
SHOP_PHONE="032 212 10 28"
SHOP_EMAIL=info@iapi.ge
SHOP_DELIVERY_DAYS=2
SHOP_COMPANY=
SHOP_TAX_ID=
SHOP_ADDRESS=
SHOP_BANK=
SHOP_SWIFT=
SHOP_IBAN=
SHOP_INVOICE_DAYS=3

# schema.org sameAs — full profile URLs, or leave blank
SHOP_FACEBOOK=
SHOP_INSTAGRAM=
SHOP_YOUTUBE=
SHOP_LINKEDIN=

# ---------------------------------------------------------------- Meta pixel
# The browser and the Conversions API both need the id; only the server needs
# the token. Without the token nothing is sent from PHP and only the browser
# half survives — which is the half ad blockers remove.
FACEBOOK_PIXEL_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_API_VERSION=v24.0

# While this is set every event lands in Test Events only. Empty it when done.
FACEBOOK_TEST_EVENT_CODE=
